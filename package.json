{
  "name": "reader",
  "version": "0.4.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:fixtures": "node --test scripts/fixtures/*.test.mjs && node scripts/fixtures/epub-fixture-manifest.mjs",
    "test:tdd:guardian": "node --test scripts/tdd/*.test.mjs",
    "test:tdd:fast": "npm run test:tdd:guardian && npm run test:fixtures && npm run test:unit:coverage && npm run test:rust",
    "test:tdd:verify": "npm run build && cargo check --manifest-path src-tauri/Cargo.toml && npm run test:tdd:fast",
    "test:tdd:gate": "node scripts/tdd/gate.mjs",
    "website:dev": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "website:preview": "npm run preview --prefix website"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/turndown": "^5.0.6",
    "@xenova/transformers": "^2.17.2",
    "foliate-js": "https://github.com/johnfactotum/foliate-js/archive/78914aef4466eb960965702401634c2cb348e9b1.tar.gz",
    "katex": "^0.16.38",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.22.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
